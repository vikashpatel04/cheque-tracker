# Supabase — your project's URL and publishable (or legacy anon) key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Branding (optional). Copies offered to other people must use their own name
# and logo; see TRADEMARKS.md.
# VITE_APP_NAME=Cheque Tracker
# VITE_APP_TAGLINE=Track every cheque. Never miss a date.
# VITE_SITE_URL=https://chequetracker.com

# Source code link (optional). Leave unset and the app shows no link. If you
# change the code and let others use your copy, AGPL-3.0 section 13 asks you to
# offer them your source: point this at your fork and the app links to it.
# VITE_SOURCE_URL=https://github.com/your-name/your-fork
