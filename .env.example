# Supabase — your project's URL and publishable (or legacy anon) key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Branding (optional). Copies offered to other people must use their own name
# and logo; see TRADEMARKS.md.
# VITE_APP_NAME=Cheque Tracker
# VITE_APP_TAGLINE=Track every cheque. Never miss a date.
# VITE_APP_LOGO=/my-logo.webp

# Your website, if the app has one beside it (optional). The sign-in pages then
# show "Back to website", and sign-up links to its /terms and /privacy. With
# VITE_COOKIE_DOMAIN set to the parent domain both share, signing in sets a
# flag (never a token) the website can read to send signed-in visitors on to
# the app. See docs/hosting.md.
# VITE_SITE_URL=https://example.com
# VITE_COOKIE_DOMAIN=.example.com

# Source code link (optional). Leave unset and the app shows no link. If you
# change the code and let others use your copy, AGPL-3.0 section 13 asks you to
# offer them your source: point this at your fork and the app links to it.
# VITE_SOURCE_URL=https://github.com/your-name/your-fork

# Bot check on sign-up and sign-in (optional; the hosted edition uses it).
# A Cloudflare Turnstile site key. Turn on CAPTCHA protection in Supabase
# (Authentication > Attack Protection) with the matching secret key only after
# the app with this key is deployed. See docs/editions.md.
# VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
